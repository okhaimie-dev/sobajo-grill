# Copy to .env.local for local dev; set the same keys in Vercel →
# Project → Settings → Environment Variables. All are optional: anything
# unset is simply switched off.

# --- Sanity CMS (content editor at /studio) ----------------------------
# Public project settings. Unset project ID → the site uses the seed content
# in lib/*.ts (no CMS).
NEXT_PUBLIC_SANITY_PROJECT_ID=n4i8duqa
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Shared secret for the publish webhook (sanity.io/manage → API → Webhooks →
# Secret) that calls /api/revalidate. Generate: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Local only, never in Vercel: Editor token for `npm run sanity:import`.
SANITY_API_WRITE_TOKEN=

# --- SEO ---------------------------------------------------------------
# Canonical site URL. Defaults to Vercel's production domain.
# Set to https://sobajogrill.com once the custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (public IDs, safe in the browser) -------------------------
# GA4: Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta Pixel: Events Manager → Data sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google (live reviews, hours, map) ---------------------------------
# Server key: Google Cloud → APIs & Services → enable "Places API (New)".
# Restrict the key to that API. Billed per call (reviews = Place Details
# Enterprise + Atmosphere); set a daily quota cap as a budget stop.
GOOGLE_MAPS_API_KEY=
# Browser key for the map: enable "Maps Embed API" (free). Restrict it by
# HTTP referrer to your domains (sobajo-grill.vercel.app/*, sobajogrill.com/*).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Optional but recommended: pins the exact listing and skips the lookup.
# The server logs the resolved ID on first use ("[google-place] resolved…").
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# --- Leads → CRM (server-only secrets) -----------------------------------
# Twenty: Settings → Developers → API → + Create key
TWENTY_API_KEY=
# Twenty Cloud default; self-hosted: https://crm.your-domain
TWENTY_API_URL=https://api.twenty.com
# Instant "new lead" ping: Slack incoming webhook, Discord webhook, or a
# Zapier/Make/n8n hook URL.
LEAD_WEBHOOK_URL=

# --- Payments: Square hosted checkout (server-only secrets) ---------------
# developer.squareup.com → Applications → your app → Credentials/Locations.
# "sandbox" (default) uses test cards; switch to "production" with the
# production token + location ID to take real payments.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
